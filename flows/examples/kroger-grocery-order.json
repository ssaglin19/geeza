{
  "name": "Kroger Grocery Order",
  "vendor": "Kroger",
  "version": 1,
  "entry_url": "https://www.kroger.com/signin",
  "spends": true,
  "thresholds": {
    "act": 0.85,
    "confirm": 0.5
  },
  "pages": [
    {
      "name": "login",
      "match": {
        "url_host": "www.kroger.com",
        "url_contains": "/signin",
        "anchors": [
          {"selector": "#email", "weight": 3},
          {"selector": "#password", "weight": 3},
          {"text": "Sign In", "weight": 2},
          {"text": "Email Address", "weight": 1},
          {"text": "Password", "weight": 1}
        ]
      },
      "steps": [
        {"action": "fill", "params": {"selector": "#email", "value": "$credentials.kroger.username"}},
        {"action": "fill", "params": {"selector": "#password", "value": "$credentials.kroger.password"}},
        {"action": "click", "params": {"selector": "#signin-btn"}},
        {"action": "wait", "params": {}}
      ]
    },
    {
      "name": "account",
      "match": {
        "url_host": "www.kroger.com",
        "url_contains": "/account",
        "anchors": [
          {"text": "My Account", "weight": 3},
          {"text": "Recent Purchases", "weight": 2},
          {"text": "Start Shopping", "weight": 2},
          {"selector": ".account-name", "weight": 3}
        ]
      },
      "steps": [
        {"action": "click", "params": {"selector": ".cart-link"}},
        {"action": "wait", "params": {}}
      ]
    },
    {
      "name": "search",
      "match": {
        "url_host": "www.kroger.com",
        "url_contains": "/search",
        "anchors": [
          {"selector": ".product-grid", "weight": 3},
          {"text": "Search Results", "weight": 2},
          {"selector": ".product-card", "weight": 3},
          {"text": "milk", "weight": 1}
        ]
      },
      "steps": [
        {"action": "click", "params": {"selector": ".product-card"}},
        {"action": "wait", "params": {}}
      ]
    },
    {
      "name": "product",
      "match": {
        "url_host": "www.kroger.com",
        "url_contains": "/p/",
        "anchors": [
          {"selector": "#add-to-cart", "weight": 3},
          {"text": "Add to Cart", "weight": 2},
          {"selector": ".product-price", "weight": 3},
          {"text": "1 gal", "weight": 1}
        ]
      },
      "steps": [
        {"action": "click", "params": {"selector": "#add-to-cart"}},
        {"action": "wait", "params": {}}
      ]
    },
    {
      "name": "cart",
      "match": {
        "url_host": "www.kroger.com",
        "url_contains": "/cart",
        "anchors": [
          {"text": "Shopping Cart", "weight": 3},
          {"text": "Checkout", "weight": 3},
          {"selector": ".cart-total", "weight": 3},
          {"text": "Estimated Total", "weight": 2}
        ]
      },
      "steps": [
        {"action": "read", "params": {"selector": ".cart-total", "as": "cart_total"}},
        {"action": "gate", "params": {"type": "amount_sanity", "value_key": "cart_total", "last_key": "baselines.cart_total", "within_pct": 30.0}},
        {"action": "click", "params": {"selector": "#checkout-btn"}},
        {"action": "wait", "params": {}}
      ]
    },
    {
      "name": "checkout",
      "match": {
        "url_host": "www.kroger.com",
        "url_contains": "/checkout",
        "anchors": [
          {"text": "Review Order", "weight": 3},
          {"text": "Place Order", "weight": 3},
          {"selector": ".order-total", "weight": 3},
          {"text": "Pickup", "weight": 2}
        ]
      },
      "steps": [
        {"action": "read", "params": {"selector": ".order-total", "as": "order_total"}},
        {"action": "gate", "params": {"type": "amount_sanity", "value_key": "order_total", "last_key": "baselines.order_total", "within_pct": 30.0}},
        {"action": "confirm", "params": {"message": "Order total: ${order_total}. Place this grocery order?"}},
        {"action": "complete", "params": {}}
      ]
    }
  ]
}
